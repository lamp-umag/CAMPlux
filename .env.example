# Copy to .env in this same directory (docker compose reads it automatically).
#
# CAMPLUX_AUTH_HASH is a bcrypt hash, not the plaintext password -- generate it with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password-here'
# then paste the output (starts with $2a$ or $2b$) below.

CAMPLUX_AUTH_USER=lamp
CAMPLUX_AUTH_HASH=
